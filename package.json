{
  "name": "context-cpx",
  "version": "0.1.19",
  "type": "module",
  "description": "Generic agent<->model plaintext capture proxy for Context-Insight",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guixu-labs/cpx.git"
  },
  "homepage": "https://github.com/guixu-labs/cpx#readme",
  "bugs": {
    "url": "https://github.com/guixu-labs/cpx/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "cpx": "./bin/cpx.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "scripts/postinstall.mjs",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "proxy": "tsx src/server.ts",
    "cpx-cli": "tsx src/cli/cpx-cli.ts",
    "test": "bash scripts/run-tests.sh && bash scripts/run-tests.sh e2e",
    "test:ut": "bash scripts/run-tests.sh",
    "test:e2e": "bash scripts/run-tests.sh e2e",
    "release:preflight": "node scripts/release/preflight-publish.mjs",
    "release:prepare-beta-version": "node scripts/release/prepare-beta-version.mjs",
    "release:prepare": "node scripts/release/build-artifacts.mjs",
    "release:verify": "node scripts/release/check-tarballs.mjs && node scripts/release/smoke-install.mjs",
    "release:verify-registry": "node scripts/release/verify-registry.mjs"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "fzstd": "^0.1.1",
    "tsx": "^4.22.4",
    "undici": "^6.29.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
