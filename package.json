{
  "name": "cannbot-proxy",
  "version": "0.1.7",
  "type": "module",
  "description": "Generic agent<->model plaintext capture proxy for CANNBot-Insight",
  "license": "SEE LICENSE IN LICENSE",
  "bin": {
    "cpx": "./bin/cpx.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "bin",
    "docs",
    "scripts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "proxy": "tsx src/server.ts",
    "cpx-cli": "tsx src/cli/cpx-cli.ts",
    "test": "bash scripts/run-tests.sh",
    "test:e2e": "bash scripts/run-tests.sh e2e",
    "test:all": "bash scripts/run-tests.sh && bash scripts/run-tests.sh e2e"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "fzstd": "^0.1.1",
    "tsx": "^4.22.4",
    "undici": "^6.28.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7"
  }
}
